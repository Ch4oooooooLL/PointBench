# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Python, TypeScript, Frontend & Configuration
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.conf text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pyc binary
*.fem binary
